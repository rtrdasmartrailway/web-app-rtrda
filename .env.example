# Postgres connection string.
# For VPS with Unix socket (same server as app, lowest latency):
DATABASE_URL=postgres:///rtrda?host=/var/run/postgresql
# For TCP connection:
# DATABASE_URL=postgresql://user:password@localhost:5432/rtrda

# Public site URL (used for metadata canonical URLs and Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.rtrda.or.th

# ─── Authentication (Better Auth + Microsoft Entra ID) ──────────────────────
# Base URL Better Auth runs on (usually same as the site URL; localhost in dev).
BETTER_AUTH_URL=http://localhost:3000
# Random secret for signing sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Microsoft Entra ID (Azure AD) app registration credentials.
# Redirect URI to register in the app: <BETTER_AUTH_URL>/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Your tenant GUID to restrict sign-in to your organization, or "common" for any
# Microsoft account.
MICROSOFT_TENANT_ID=common

# DEV ONLY: set to 1 to bypass Microsoft login and act as an admin while testing
# the content-management features locally. Ignored when NODE_ENV=production.
# Leave unset/0 for any real deployment.
NEXT_PUBLIC_DEV_AUTH_BYPASS=0
