{
  "name": "web-app-rtrda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "import:wordpress": "node scripts/import-wordpress.mjs",
    "audit:parity": "node scripts/audit-parity.mjs",
    "audit:divergence": "node scripts/audit-divergence.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node scripts/seed-db.mjs",
    "db:studio": "prisma studio",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "git ls-files -z | xargs -0 prettier --check --ignore-unknown",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "cheerio": "^1.2.0",
    "next": "^16.2.11",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.3",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "prettier": "3.8.4",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "8.5.19",
    "sharp": "$sharp",
    "find-my-way": "9.7.0",
    "valibot": "1.4.2",
    "deepmerge-ts": "8.0.1",
    "mysql2": "3.24.3"
  }
}
