// Content database — the source of truth for everything the site serves.
// Models mirror the legacy import manifest types (src/lib/wp/types.ts) 1:1;
// `src/data/wp-content.json` is the frozen import artifact that seeded it
// (scripts/seed-db.mjs).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContentRecord {
  id              String  @id
  wpId            String
  language        String
  kind            String
  path            String  @unique
  sourceUrl       String
  title           String
  excerpt         String
  contentHtml     String
  /// Plain-text body used by site search (trigram-indexed; see migration SQL).
  searchText      String  @default("")
  /// ISO-8601 strings, kept as text: they sort correctly and the UI formats them.
  date            String
  modified        String
  parentPath      String?
  categoryIds     Int[]
  featuredMediaId Int?
  authorId        Int?

  @@index([language, kind, date])
  @@index([parentPath])
}

model Category {
  /// WordPress term id — only unique per language, hence the composite id.
  id       Int
  language String
  path     String
  slug     String
  name     String
  count    Int
  parent   Int

  @@id([id, language])
}

model MediaAsset {
  id        String @id
  sourceUrl String
  localPath String
  title     String
  alt       String
  width     Int?
  height    Int?
  mimeType  String
}

model Download {
  id          String   @id
  sourceUrl   String
  localPath   String
  fileName    String
  mimeType    String
  sizeBytes   Int
  title       String
  group       String
  sourcePages String[]
}

/// Small key/JSON store: navigation trees, generatedAt, source.
model SiteMeta {
  key   String @id
  value Json
}

enum PrCenterRoleCode {
  REQUESTER
  PR_OPERATIONS
  APPROVER
  EXECUTIVE_READ_ONLY
  SCOPED_ADMINISTRATOR
}

enum PrRequestType {
  PR
  OFFSITE
}

enum PrRequestStatus {
  DRAFT
  SUBMITTED
  WITHDRAWN
  CANCELLED
  CLOSED
}

enum PrTaskStatus {
  DRAFT
  WAITING_FOR_INFORMATION
  COMMUNICATION_PLANNING
  IN_PRODUCTION
  SOURCE_FACT_CHECK
  TECHNICAL_REVIEW
  PR_EDITORIAL_REVIEW
  MANAGEMENT_APPROVAL
  REVISION_REQUIRED
  APPROVED
  SCHEDULED
  PUBLISHED
  CLOSED
  REJECTED
  CANCELLED
}

enum PrApprovalDecision {
  APPROVED
  REVISION_REQUIRED
  REJECTED
  WITHDRAWN
  REPLACED
}

enum PrFileScanStatus {
  PENDING
  CLEAN
  QUARANTINED
  FAILED
}

enum PrContentIdeaStatus {
  PROPOSED
  UNDER_REVIEW
  ACCEPTED
  CONVERTED
  ARCHIVED
}

enum PrMessageHouseStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SUPERSEDED
}

enum PrOutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

model PrOrganization {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique
  name        String
  departments PrDepartment[]
  users       PrCenterUser[]
  requests    PrRequest[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model PrDepartment {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  code           String
  name           String
  active         Boolean        @default(true)
  organization   PrOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users          PrCenterUser[]
  requests       PrRequest[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organizationId, code])
}

model PrCenterUser {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  departmentId   String?          @db.Uuid
  ssoSubject     String           @unique
  email          String           @unique
  displayName    String
  position       String?
  active         Boolean          @default(true)
  organization   PrOrganization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department     PrDepartment?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  roles          PrUserRole[]
  requests       PrRequest[]      @relation("PrRequester")
  assignedTasks  PrTask[]         @relation("PrTaskOwner")
  comments       PrComment[]
  approvals      PrApproval[]
  notifications  PrNotification[]
  auditEvents    PrAuditEvent[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, departmentId, active])
}

model PrUserRole {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  role           PrCenterRoleCode
  organizationId String           @db.Uuid
  departmentId   String?          @db.Uuid
  user           PrCenterUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@unique([userId, role, organizationId, departmentId])
  @@index([organizationId, departmentId, role])
}

model PrRequest {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  departmentId   String              @db.Uuid
  requesterId    String              @db.Uuid
  requestNumber  String              @unique
  type           PrRequestType
  status         PrRequestStatus     @default(DRAFT)
  title          String
  priority       String              @default("NORMAL")
  priorityReason String?
  requestedFor   DateTime?
  version        Int                 @default(1)
  organization   PrOrganization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department     PrDepartment        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  requester      PrCenterUser        @relation("PrRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  revisions      PrRequestRevision[]
  sources        PrRequestSource[]
  tasks          PrTask[]
  comments       PrComment[]
  attachments    PrAttachment[]
  statusHistory  PrStatusHistory[]
  convertedIdeas PrContentIdea[]     @relation("PrIdeaConversion")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, departmentId, status, createdAt])
  @@index([requesterId, createdAt])
}

model PrContentIdea {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  departmentId       String              @db.Uuid
  proposerId         String              @db.Uuid
  title              String
  rationale          String
  audience           String?
  pillar             String?
  channel            String?
  priority           String?
  campaign           String?
  evidenceUrls       Json?
  status             PrContentIdeaStatus @default(PROPOSED)
  reviewerId         String?             @db.Uuid
  decisionReason     String?
  convertedRequestId String?             @unique @db.Uuid
  version            Int                 @default(1)
  convertedRequest   PrRequest?          @relation("PrIdeaConversion", fields: [convertedRequestId], references: [id], onDelete: Restrict)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([organizationId, departmentId, status, createdAt])
  @@index([proposerId, createdAt])
}

model PrMessageHouseVersion {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @db.Uuid
  versionNumber   Int
  status          PrMessageHouseStatus @default(DRAFT)
  vision          String
  positioning     String
  pillars         Json
  foundation      String
  sourceRationale String?
  ownerId         String?              @db.Uuid
  reviewerId      String?              @db.Uuid
  approverId      String?              @db.Uuid
  effectiveAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([organizationId, versionNumber])
  @@index([organizationId, status, effectiveAt])
}

model PrRequestRevision {
  id             String    @id @default(uuid()) @db.Uuid
  requestId      String    @db.Uuid
  revisionNumber Int
  title          String
  objective      String?
  audience       String?
  offsiteDetails Json?
  changeSummary  String?
  immutableAt    DateTime?
  request        PrRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  @@unique([requestId, revisionNumber])
}

model PrRequestSource {
  id        String    @id @default(uuid()) @db.Uuid
  requestId String    @db.Uuid
  url       String
  label     String?
  request   PrRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model PrTask {
  id            String            @id @default(uuid()) @db.Uuid
  requestId     String            @db.Uuid
  ownerId       String?           @db.Uuid
  title         String
  contentType   String
  channel       String?
  status        PrTaskStatus      @default(DRAFT)
  dueAt         DateTime?
  version       Int               @default(1)
  request       PrRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  owner         PrCenterUser?     @relation("PrTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  revisions     PrTaskRevision[]
  approvals     PrApproval[]
  schedules     PrSchedule[]
  comments      PrComment[]
  attachments   PrAttachment[]
  statusHistory PrStatusHistory[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([requestId, status])
  @@index([ownerId, status, dueAt])
}

model PrTaskRevision {
  id             String    @id @default(uuid()) @db.Uuid
  taskId         String    @db.Uuid
  revisionNumber Int
  body           String?
  keyMessage     String?
  finalAssetId   String?   @db.Uuid
  immutableAt    DateTime?
  task           PrTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  @@unique([taskId, revisionNumber])
}

model PrApproval {
  id           String             @id @default(uuid()) @db.Uuid
  taskId       String             @db.Uuid
  taskRevision Int
  stage        String
  decision     PrApprovalDecision
  comment      String?
  decidedById  String             @db.Uuid
  decidedAt    DateTime           @default(now())
  task         PrTask             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  decidedBy    PrCenterUser       @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([taskId, taskRevision, stage])
}

model PrSchedule {
  id                 String    @id @default(uuid()) @db.Uuid
  taskId             String    @db.Uuid
  channel            String
  scheduledFor       DateTime
  idempotencyKey     String    @unique
  publishedUrl       String?
  publishedReference String?
  publishedAt        DateTime?
  task               PrTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([channel, scheduledFor])
}

model PrFileObject {
  id          String           @id @default(uuid()) @db.Uuid
  storageKey  String           @unique
  fileName    String
  mimeType    String
  sizeBytes   Int
  checksum    String
  scanStatus  PrFileScanStatus @default(PENDING)
  scannedAt   DateTime?
  attachments PrAttachment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([scanStatus])
}

model PrAttachment {
  id        String       @id @default(uuid()) @db.Uuid
  requestId String?      @db.Uuid
  taskId    String?      @db.Uuid
  fileId    String       @db.Uuid
  kind      String
  version   Int          @default(1)
  request   PrRequest?   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  task      PrTask?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  file      PrFileObject @relation(fields: [fileId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now())

  @@index([requestId, kind])
  @@index([taskId, kind])
}

model PrComment {
  id        String       @id @default(uuid()) @db.Uuid
  requestId String?      @db.Uuid
  taskId    String?      @db.Uuid
  authorId  String       @db.Uuid
  body      String
  request   PrRequest?   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  task      PrTask?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    PrCenterUser @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model PrStatusHistory {
  id        String     @id @default(uuid()) @db.Uuid
  requestId String?    @db.Uuid
  taskId    String?    @db.Uuid
  fromState String?
  toState   String
  reason    String?
  actorId   String     @db.Uuid
  request   PrRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  task      PrTask?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
}

model PrNotification {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  title     String
  body      String
  target    String?
  readAt    DateTime?
  user      PrCenterUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([userId, readAt, createdAt])
}

model PrAuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  actorId        String?       @db.Uuid
  action         String
  entityType     String
  entityId       String
  correlationId  String
  before         Json?
  after          Json?
  createdAt      DateTime      @default(now())
  actor          PrCenterUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([correlationId])
}

model PrOutboxEvent {
  id             String         @id @default(uuid()) @db.Uuid
  aggregateType  String
  aggregateId    String
  eventType      String
  payload        Json
  idempotencyKey String         @unique
  status         PrOutboxStatus @default(PENDING)
  attempts       Int            @default(0)
  availableAt    DateTime       @default(now())
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime       @default(now())

  @@index([status, availableAt])
}
